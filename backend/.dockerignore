# Keep the image to what the app needs at runtime. Anything matched here never reaches
# `COPY . .`, so local secrets and machine-specific files can't leak into an image.

# Secrets and local settings: the container gets its settings from the environment.
.env
.env.*
!.env.example

# Local Python environments and caches (built for the host OS, not the image).
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Tests and test-only dependencies.
tests/
pytest.ini
requirements-dev.txt

# Build files.
Dockerfile
.dockerignore
