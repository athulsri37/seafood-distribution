# Copy to backend/.env and fill in. Never commit the copy: it's git-ignored and kept out
# of Docker images.

# PostgreSQL connection, including the password you chose for your database.
DATABASE_URL=postgresql://seafood:<password>@localhost:5432/seafood_distribution

# Signs login tokens. At least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. Comma-separated origins allowed to call the API from another site, such as
# https://app.example.com. Leave empty when the frontend proxies /api (the default setup).
CORS_ORIGINS=
