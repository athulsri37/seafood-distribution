# Settings for docker compose. Copy to .env next to docker-compose.yml and fill in.
# Never commit the copy: it's git-ignored.

# Password for the compose PostgreSQL container (any value you choose).
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
